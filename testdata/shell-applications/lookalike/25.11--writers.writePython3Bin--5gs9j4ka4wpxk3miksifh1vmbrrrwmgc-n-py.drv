Derive([("out","/nix/store/2m92vl7cqfpjgpmq5x4fk80b2zzzblbk-n-py","","")],[("/nix/store/16a1kp5xni7jz2rsklsj56sgw0b5ryr8-pythoncheck.sh.drv",["out"]),("/nix/store/gc56b6ig6rwz0v4n5jffnigbxyl7gysk-stdenv-linux.drv",["out"]),("/nix/store/gz423mnfsshyz0c3vrc633m8vwb5lxmm-bash-5.3p3.drv",["out"]),("/nix/store/l2sw6i81vramic8pan3nxp1m0638d2yn-python3-3.13.12.drv",["out"]),("/nix/store/sd9qzzv8cd6xnl58152xw9fcz4fa4brl-make-binary-wrapper-hook.drv",["out"])],["/nix/store/l622p70vy8k5sh7y5wizi5f2mic6ynpg-source-stdenv.sh","/nix/store/shkw4qm9qcw5sc5n1k5jznc83ny02r39-default-builder.sh"],"x86_64-linux","/nix/store/3hgg7pr65imdrifqqh3flg3arvkc2r22-bash-5.3p3/bin/bash",["-e","/nix/store/l622p70vy8k5sh7y5wizi5f2mic6ynpg-source-stdenv.sh","/nix/store/shkw4qm9qcw5sc5n1k5jznc83ny02r39-default-builder.sh"],[("NIX_MAIN_PROGRAM","n-py"),("__structuredAttrs",""),("allowSubstitutes",""),("buildCommand","# On darwin a script cannot be used as an interpreter in a shebang but\n# there doesn't seem to be a limit to the size of shebang and multiple\n# arguments to the interpreter are allowed.\nif [[ -n \"\" ]] && isScript $interpreter\nthen\n  wrapperInterpreterLine=$(head -1 \"$interpreter\" | tail -c+3)\n  # Get first word from the line (note: xargs echo remove leading spaces)\n  wrapperInterpreter=$(echo \"$wrapperInterpreterLine\" | xargs echo | cut -d \" \" -f1)\n\n  if isScript $wrapperInterpreter\n  then\n    echo \"error: passed interpreter ($interpreter) is a script which has another script ($wrapperInterpreter) as an interpreter, which is not supported.\"\n    exit 1\n  fi\n\n  # This should work as long as wrapperInterpreter is a shell, which is\n  # the case for programs wrapped with makeWrapper, like\n  # python3.withPackages etc.\n  interpreterLine=\"$wrapperInterpreterLine $interpreter\"\nelse\n  interpreterLine=$interpreter\nfi\n\necho \"#! $interpreterLine\" > $out\ncat \"$contentPath\" >> $out\n/nix/store/8f2d0mz780i2viacv925k8d8wm2rlblp-pythoncheck.sh $out\n\nchmod +x $out\n\n# Relocate executable\n# Wrap it if makeWrapperArgs are specified\nmv $out tmp\n  mkdir -p $out/$(dirname \"/bin/n-py\")\n  mv tmp $out//bin/n-py\nif [ -n \"${makeWrapperArgs+${makeWrapperArgs[@]}}\" ]; then\n    wrapProgram $out//bin/n-py ${makeWrapperArgs[@]}\nfi\n"),("buildInputs",""),("builder","/nix/store/3hgg7pr65imdrifqqh3flg3arvkc2r22-bash-5.3p3/bin/bash"),("cmakeFlags",""),("configureFlags",""),("content","print(1)"),("depsBuildBuild",""),("depsBuildBuildPropagated",""),("depsBuildTarget",""),("depsBuildTargetPropagated",""),("depsHostHost",""),("depsHostHostPropagated",""),("depsTargetTarget",""),("depsTargetTargetPropagated",""),("doCheck",""),("doInstallCheck",""),("enableParallelBuilding","1"),("enableParallelChecking","1"),("enableParallelInstalling","1"),("interpreter","/nix/store/vm6nxpp97fxgczw00bwkxdqdm2an3n95-python3-3.13.12/bin/python3.13"),("makeWrapperArgs",""),("mesonFlags",""),("name","n-py"),("nativeBuildInputs","/nix/store/14ral1rxxihyhbffa7rygv9ymd35babc-make-binary-wrapper-hook"),("out","/nix/store/2m92vl7cqfpjgpmq5x4fk80b2zzzblbk-n-py"),("outputs","out"),("passAsFile","buildCommand content"),("patches",""),("preferLocalBuild","1"),("propagatedBuildInputs",""),("propagatedNativeBuildInputs",""),("stdenv","/nix/store/pvir9l70j66xb9prq9cvq313r2n2na58-stdenv-linux"),("strictDeps",""),("system","x86_64-linux")])
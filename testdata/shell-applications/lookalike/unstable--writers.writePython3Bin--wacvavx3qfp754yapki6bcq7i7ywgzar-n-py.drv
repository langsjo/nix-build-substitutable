Derive([("out","/nix/store/62qy4fh4ghvilg29gf9l77z5frxkhmh5-n-py","","")],[("/nix/store/30hr2syjmfvflwi68acggp3w870ikw5c-bash-5.3p20.drv",["out"]),("/nix/store/jrjq3n2gpgq6sn07iiymh8ivf19ahncm-stdenv-linux-no-cc.drv",["out"]),("/nix/store/kshlqxnavgrg7caxhk7ga3j4hyvkcz3h-pythoncheck.sh.drv",["out"]),("/nix/store/vg2yqik90dgl8dvyx73c07bi5pf9kz0r-make-binary-wrapper-hook.drv",["out"]),("/nix/store/w1svn0lba9gv480i37z2q97yi4155mlr-python3-3.14.8.drv",["out"])],["/nix/store/l622p70vy8k5sh7y5wizi5f2mic6ynpg-source-stdenv.sh","/nix/store/shkw4qm9qcw5sc5n1k5jznc83ny02r39-default-builder.sh"],"x86_64-linux","/nix/store/nnm9gdr70ihc6zc9298mzz8jpcgaciql-bash-5.3p20/bin/bash",["-e","/nix/store/l622p70vy8k5sh7y5wizi5f2mic6ynpg-source-stdenv.sh","/nix/store/shkw4qm9qcw5sc5n1k5jznc83ny02r39-default-builder.sh"],[("NIX_MAIN_PROGRAM","n-py"),("__structuredAttrs",""),("allowSubstitutes",""),("buildCommand","# On darwin a script cannot be used as an interpreter in a shebang but\n# there doesn't seem to be a limit to the size of shebang and multiple\n# arguments to the interpreter are allowed.\nif [[ -n \"\" ]] && isScript $interpreter\nthen\n  wrapperInterpreterLine=$(head -1 \"$interpreter\" | tail -c+3)\n  # Get first word from the line (note: xargs echo remove leading spaces)\n  wrapperInterpreter=$(echo \"$wrapperInterpreterLine\" | xargs echo | cut -d \" \" -f1)\n\n  if isScript $wrapperInterpreter\n  then\n    echo \"error: passed interpreter ($interpreter) is a script which has another script ($wrapperInterpreter) as an interpreter, which is not supported.\"\n    exit 1\n  fi\n\n  # This should work as long as wrapperInterpreter is a shell, which is\n  # the case for programs wrapped with makeWrapper, like\n  # python3.withPackages etc.\n  interpreterLine=\"$wrapperInterpreterLine $interpreter\"\nelse\n  interpreterLine=$interpreter\nfi\n\necho \"#! $interpreterLine\" > $out\ncat \"$contentPath\" >> $out\n/nix/store/ppqs9np9081biikyskviz1i060qbm5mf-pythoncheck.sh $out\n\nchmod +x $out\n\n# Relocate executable\n# Wrap it if makeWrapperArgs are specified\nmv $out tmp\n  mkdir -p $out/$(dirname \"/bin/n-py\")\n  mv tmp $out//bin/n-py\nif [ -n \"${makeWrapperArgs+${makeWrapperArgs[@]}}\" ]; then\n    wrapProgram $out//bin/n-py ${makeWrapperArgs[@]}\nfi\n"),("buildInputs",""),("builder","/nix/store/nnm9gdr70ihc6zc9298mzz8jpcgaciql-bash-5.3p20/bin/bash"),("cmakeFlags",""),("configureFlags",""),("content","print(1)"),("depsBuildBuild",""),("depsBuildBuildPropagated",""),("depsBuildTarget",""),("depsBuildTargetPropagated",""),("depsHostHost",""),("depsHostHostPropagated",""),("depsTargetTarget",""),("depsTargetTargetPropagated",""),("doCheck",""),("doInstallCheck",""),("enableParallelBuilding","1"),("enableParallelChecking","1"),("enableParallelInstalling","1"),("interpreter","/nix/store/xahxrjs30p3mw0a42bqg9ikgkikskw8m-python3-3.14.8/bin/python3.14"),("makeWrapperArgs",""),("mesonFlags",""),("name","n-py"),("nativeBuildInputs","/nix/store/wsmmw9pf0gd3a4r1hygr1xm71k10mqbb-make-binary-wrapper-hook"),("out","/nix/store/62qy4fh4ghvilg29gf9l77z5frxkhmh5-n-py"),("outputs","out"),("passAsFile","buildCommand content"),("patches",""),("preferLocalBuild","1"),("propagatedBuildInputs",""),("propagatedNativeBuildInputs",""),("stdenv","/nix/store/c3k15jk20fccs90qgffdwzhxy15b5fdj-stdenv-linux-no-cc"),("strictDeps",""),("system","x86_64-linux")])